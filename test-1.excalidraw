{"type":"excalidraw","version":2,"source":"http://localhost:3000","elements":[{"id":"XRCQD_nlJOsL5wJMyd8Qi","type":"diamond","x":-336.3826164928032,"y":-1191.9062512014282,"width":303.64453125,"height":320.66796875,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a0","roundness":{"type":2},"seed":1007204306,"version":52,"versionNonce":1203841857,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false},{"id":"Tm3_MjJed-gjCUmksj3Se","type":"ellipse","x":-230.6794914928032,"y":-1074.1171887014282,"width":108.97656249999999,"height":92.18359375,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a1","roundness":{"type":2},"seed":227872910,"version":50,"versionNonce":1876695841,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false},{"id":"UVGqBTzRzlAiRFF1gGp48","type":"rectangle","x":-345.1833977428032,"y":-1206.9140637014282,"width":330.06640625,"height":352.80078125,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a2","roundness":{"type":3},"seed":1867821394,"version":77,"versionNonce":1523453697,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false},{"id":"tpl-45ci35et-nYm2TKM9zWwGw2c9_8yKE","type":"text","x":422.0454321130295,"y":-774.1132824514282,"width":117.158203125,"height":50,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a24","roundness":null,"seed":1538475905,"version":68,"versionNonce":521570017,"isDeleted":