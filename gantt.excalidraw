transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b4N","roundness":null,"seed":1107987634,"version":197,"versionNonce":1926886702,"isDeleted":false,"boundElements":[],"updated":1788180783919,"link":null,"locked":false,"text":"Run a loop over numbers k from 1 to n.\nIf k*k <= n that means it's a perfect square\nNow we have to find out possible moves\nBut the moves are in favour of alice","fontSize":8,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Run a loop over numbers k from 1 to n.\nIf k*k <= n that means it's a perfect square\nNow we have to find out possible moves\nBut the moves are in favour of alice","autoResize":true,"lineHeight":1.25},{"id":"fA64thZ4uAGWEr0WdkPQr","type":"text","x":1157.78379330607,"y":-15.903360837877301,"width":193.5997314453125,"height":30,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b4O","roundness":null,"seed":1245324914,"version":176,"versionNonce":1115627374,"isDeleted":false,"boundElements":[],"updated":1788180783919,"link":null,"locked":false,"text":"solve(n,player)\n    for(k=1;k*k<=n;k++) \n        if(!solve(n-k*k,false)) return true;","fontSize":8,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"solve(n,player)\n    for(k=1;k*k<=n;k++) \n        if(!solve(n-k*k,false)) return true;","autoResize":true,"lineHeight":1.25},{"id":"pFyDsdhlPTB6ddjHx6yxE","type":"freedraw","x":1211.6329515756934,"y":13.574899106024247,"width":29.297575326835613,"height":21.516545623466982,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":0.5,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b4P","roundness":null,"seed":1691387954,"version":39,"versionNonc