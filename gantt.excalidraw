olid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3V","roundness":null,"seed":1602111026,"version":149,"versionNonce":591815598,"isDeleted":false,"boundElements":[],"updated":1788180783918,"link":null,"locked":false,"text":"Bob can take either 1 or 5","fontSize":10.887883480029824,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Bob can take either 1 or 5","autoResize":true,"lineHeight":1.25},{"id":"0OVG5AoD3V_BLnzvZtYrT","type":"text","x":206.1236933402007,"y":206.9452300718603,"width":144.90669603292517,"height":27.219708700074563,"angle":0,"strokeColor":"#f08c00","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3W","roundness":null,"seed":1140502514,"version":140,"versionNonce":945405422,"isDeleted":false,"boundElements":[],"updated":1788180783918,"link":null,"locked":false,"text":"Case 1 : Assume bob took 1\nsolve(i+1, j-1)","fontSize":10.887883480029824,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Case 1 : Assume bob took 1\nsolve(i+1, j-1)","autoResize":true,"lineHeight":1.25},{"id":"rYnC2Jjmy9tRb3DFxArl3","type":"text","x":203.33740112362136,"y":242.72325281656407,"width":149.9586816099112,"height":27.219708700074563,"angle":0,"strokeColor":"#f08c00","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3X","roundness":null,"seed":952361394,"version":197,"versionNonce":2122829870,"isDeleted":false,"boundElements":[],"updated":1788180783918,"link":null,"locked":false,"text":"Case 2 : Assume bob took 5\nsolve(i, j-2)","fontSize":10.887883480029824,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Case 2 : Assume bob took 5\nsolve(i, j-2)","autoResize":true,"lineHeight":1.25},{"id":"jG3NHwZu1WoT4cvi_x047","type":"text","x":290.642279423501,"y":140.83243921873765,"width":67.4503725350974,"height":27.219708700074563,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3Y","roundness":null,"seed":687922034,"version":156,"versionNonce":1907989102,"isDeleted":false,"boundElements":[],"updated":1788180783918,"link":null,"locked":false,"text":"nums[j] gone\nstarts i, j-1","fontSize":10.887883480029824,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"nums[j] gone\nstarts i, j-1","autoResize":true,"lineHeight":1.25},{"id":"KqFo_6n97HcJDCta74XhY","type":"text","x":-62.69731468243481,"y":51.24418705602335,"width":93.03247949776575,"height":68.0430016793223,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3Z","roundness":null,"seed":49847602,"version":445,"versionNonce":683154606,"isDeleted":false,"boundElements":[],"updated":1788180783918,"link":null,"locked":false,"text":"\n    public int solve(int[] nums, int i, int j, ){\n        // base case\n        if(i > j) return 0;\n        if(i == j) return nums[i];\n        if(player1){\n            return Math.max(\n                nums[i] + solve(nums, i+1, j, false),\n                nums[j] + solve(nums, i, j-1, false)\n            );\n        } else {\n            return Math.min(\n                solve(nums, i+1, j, true),\n                solve(nums, i, j-1, true)\n            );\n        }\n    }","fontSize":3.2020236084386964,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"\n    public int solve(int[] nums, int i, int j, ){\n        // base case\n        if(i > j) return 0;\n        if(i == j) return nums[i];\n        if(player1){\n            return Math.max(\n                nums[i] + solve(nums, i+1, j, false),\n                nums[j] + solve(nums, i, j-1, false)\n            );\n        } else {\n            return Math.min(\n                solve(nums, i+1, j, true),\n                solve(nums, i, j-1, true)\n            );\n        }\n    }","autoResize":true,"lineHeight":1.25},{"id":"0ncshojiUdBv4wIkk8p1J","type":"text","x":-96.34987258109288,"y":58.3292462712339,"width":25.890434458296703,"height":4.296869387823938,"angle":5.807316897837989,"strokeColor":"#f08c00","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3a","roundness":null,"seed":1410475762,"version":273,"versionNonce":2032948974,"isDeleted":false,"boundElements":[],"updated":1788180783918,"link":null,"locked":false,"text":"Simple recursion","fontSize":3.4374955102591507,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Simple recursion","autoResize":true,"lineHeight":1.25},{"id":"Ta8OA6WD8dwfilCXVAkJP","type":"freedraw","x":-83.16905227252494,"y":55.847385127823316,"width":41.7489428869199,"height":25.86284599544345,"angle":0,"strokeColor":"#f08c00","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3b","roundness":null,"seed":1691646130,"version":161,"versionNonce":463423790,"isDeleted":false,"boundElements":[],"updated":1788180783918,"link":null,"locked":false,"points":[[0,0],[0.011800257672376404,0],[-0.4288656147815191,0],[-3.5935472192998636,0.09993343216319828],[-8.094239247165934,1.5085891918066863],[-12.428990151513826,4.017618979402],[-15.265477089518386,6.337844644238811],[-17.59824052813211,8.904400687987094],[-19.264289408254964,11.39130499244662],[-19.823326615485158,13.072841710764484],[-19.76469408517544,14.572949467369101],[-18.39770798543764,15.55937725