ice_ans\n        else bob_ans","fontSize":8,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"cal_sort(alice_arr, bob_arr)\n    for i to alice_arr\n        sum[i][0] = alice_arr[i] + bob_arr[i]\n        sum[i][i] = i\n     sort(sum) in descending\n     return values of sum[i][1] indexes\n\nsolve(alice_arr, bob_arr, sorted)\n    for e to alice_arr \n        i = sorted[e];\n        e % 2 == 0 alice_ans\n        else bob_ans","autoResize":true,"lineHeight":1.25},{"id":"xzDI-1xWuYwKL5neCx0xE","type":"rectangle","x":750.2805732661236,"y":297.7145822749855,"width":154.39150130712528,"height":128.2774120570225,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b5R","roundness":null,"seed":1925314610,"version":62,"versionNonce":782401070,"isDeleted":false,"boundElements":[],"updated":1788180783919,"link":null,"locked":false},{"id":"Z-xBayeTpT52v1i6X6K3_","type":"rectangle","x":697.16716692217,"y":76.57901344896624,"width":295.34915096237273,"height":377.4725443808301,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b5S","roundness":null,"seed":1475879410,"version":49,"versionNonce":1716422766,"isDeleted":false,"boundElements":[],"updated":1788180783919,"link":null,"locked":false},{"id":"uV70_sxOlePGlQNUImaLx","type":"text","x":1047.352675071911,"y":107.44933613052041,"width":149.4606170654297,"height":129.88506771603303,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b5T","roundness":null,"seed":272831410,"version":333,"versionNonce":1484737198,"isDeleted":false,"boundElements":[],"updated":1788180783919,"link":null,"locked":false,"text":"Stone Game VII\n\nAlice Starts first\n\nAlmost same as classic stone game\nCan remove from first or last\n\nBut the twist is \nReceive points = sum of remaining stones\nLike really?\n\nReturn difference in alice and bob's score\nBoth play optimally","fontSize":7.992927244063572,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Stone Game VII\n\nAlice Starts first\n\nAlmost same as classic stone game\nCan remove from first or last\n\nBut the twist is \nReceive points = sum of remaining stones\nLike really?\n\nReturn difference in alice and bob's score\nBoth play optimally","autoResize":true,"lineHeight":1.25},{"id":"ONk34ROmfZYiQZDYoTX88","type":"text","x":1080.9830370511831,"y":256.27048648638487,"width":49.16790771484375,"height":10,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b5U","roundness":null,"seed":1841941874,"version":23,"versionNonce":1138607342,"isDeleted":false,"boundElements":[],"updated":1788180783919,"link":null,"locked":false,"text":"[ 5, 3, 1, 4, 2 ]","fontSize":8,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"[ 5, 3, 1, 4, 2 ]","autoResize":true,"lineHeight":1.25},{"id":"aHlim5GFZ-S0ISr4hsr07","type":"freedraw","x":1087.0190255907037,"y":268.17383861773106,"width":4.841732233007406,"height":0.34360306536302687,"angle":0,"strokeColor":"#f08c00","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b5V","roundness":null,"seed":1708347186,"version":23,"versionNonce":703788846,"isDeleted":false,"boundElements":[],"updated":1788180783919,"link":null,"locked":false,"points":[[0,0],[0.0324481815521267,0],[0.9844546510148575,0],[2.4150717983695813,0],[3.1127077017372358,0],[3.137043837901274,0],[2.3872590713249