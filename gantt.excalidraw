.0300619604810208],[4.873710775528025,-1.0201834238067704],[1.8975770902322893,-0.7202351284270208],[0.36820000331067604,-0.5038053703834748],[-0.042208293062458324,-0.4633931748981013],[-0.11764439130161009,-0.4436361015498278],[0,0]],"pressures":[],"simulatePressure":true,"strokeOptions":{"variability":"constant","streamline":0.5},"lastCommittedPoint":null},{"id":"0BvrSKb5-kPuJz-viJFv4","type":"text","x":501.8655991323694,"y":-121.90804562783211,"width":66.97381455104859,"height":12.177074082681997,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3t","roundness":null,"seed":545771570,"version":164,"versionNonce":1573730734,"isDeleted":false,"boundElements":[],"updated":1788180783918,"link":null,"locked":false,"text":"you take the sum\nsolveand find the greater","fontSize":4.870829633072799,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"you take the sum\nsolveand find the greater","autoResize":true,"lineHeight":1.25},{"id":"tCR69JgCiVKtufG_KoTQA","type":"text","x":412.0969416822942,"y":-20.198875980855235,"width":146.98064501940547,"height":90.7289190776223,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3u","roundness":null,"seed":2135095794,"version":198,"versionNonce":1737872366,"isDeleted":false,"boundElements":[],"updated":1788180783918,"link":null,"locked":false,"text":"    public int solve(int[] piles, int i, int j, boolean alice, Integer[][][] dp){\n        if(i > j) return 0;\n        if(i == j) return piles[i];\n        int talice = 0;\n        if(alice) talice = 1;\n        else talice = 0;\n        if(dp[i][j][talice] != null) return dp[i][j][talice];\n        int ans = 0;\n        if(alice){\n            ans = Math.max(\n                piles[i] + solve(piles, i+1, j, false, dp),\n                piles[j] + solve(piles, i, j-1, false, dp)\n            );\n        } else {\n            ans = Math.min(\n                solve(piles, i+1, j, true, dp),\n                solve(piles, i, j-1, true, dp)\n            );\n        }\n        return dp[i][j][talice] = ans;\n    }\n","fontSize":3.2992334210044496,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"    public int solve(int[] piles, int i, int j, boolean alice, Integer[][][] dp){\n        if(i > j) return 0;\n        if(i == j) return piles[i];\n        int talice = 0;\n        if(alice) talice = 1;\n        else talice = 0;\n        if(dp[i][j][talice] != null) return dp[i][j][talice];\n        int ans = 0;\n        if(alice){\n            ans = Math.max(\n                piles[i] + solve(piles, i+1, j, false, dp),\n                piles[j] + solve(piles, i, j-1, false, dp)\n            );\n        } else {\n            ans = Math.min(\n                solve(piles, i+1, j, true, dp),\n                solve(piles, i, j-1, true, dp)\n            );\n        }\n        return dp[i][j][talice] = ans;\n    }\n","autoResize":true,"lineHeight":1.25},{"id":"X4Z9JLtdFZM5ZXu2-52sy","type":"text","x":414.69588929804456,"y":-34.60776668661532,"width":96.33586120605469,"height":10,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3v","roundness":null,"seed":947055538,"version":180,"versionNonce":1506879022,"isDeleted":false,"boundElements":[],"updated":1788180783918,"link":null,"locked":false,"text":"OR 3D dp for memoization","fontSize":8,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"OR 3D dp for memoization","autoResize":true,"lineHeight":1.25},{"id":"Z7PIE_35hZwXrndvXBTKW","type":"rectangle","x":404.2416415165734,"y":-255.63376