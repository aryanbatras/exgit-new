t","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3z","roundness":null,"seed":1471054514,"version":282,"versionNonce":344825646,"isDeleted":false,"boundElements":[],"updated":1788180783918,"link":null,"locked":false,"text":"Accumulate the stones\nIf greater than half - wins","fontSize":8,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Accumulate the stones\nIf greater than half - wins","autoResize":true,"lineHeight":1.25},{"id":"7yyOgkjPCyVdZxA5U1dKu","type":"text","x":612.5588162754525,"y":-247.2237844827855,"width":50.695892333984375,"height":10,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b40","roundness":null,"seed":871324786,"version":243,"versionNonce":70093166,"isDeleted":false,"boundElements":[],"updated":1788180783918,"link":null,"locked":false,"text":"Stone Game II","fontSize":8,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Stone Game II","autoResize":true,"lineHeight":1.25},{"id":"epAG8CDnK6Qj3xAXQtE36","type":"text","x":598.9923147388822,"y":-133.39197509289642,"width":179.37247388860712,"height":61.581883126558864,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b41","roundness":null,"seed":242155058,"version":284,"versionNonce":1154886574,"isDeleted":false,"boundElements":[],"updated":1788180783918,"link":null,"locked":false,"text":"Alice starts first - optimal play\nP1 - take X piles - where X can be 1 to 2M - where M = 1\nP1 can choose btw min 1 or max 2, obviously max 2 so X = 2\nP2 - M = max(M,X) = max(1,2) = 2\nP2 now has 1 <= X <= 2(2) that is 4 piles to take\nBob will easily win\nP1 has to smartly choose M and not greedily choose the max\nBecause p2 will get the advantage otherwise\nPREFIX SUM - ADDING PAST NUMBERS","fontSize":5.473945166805232,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Alice starts first - optimal play\nP1 - take X piles - where X can be 1 to 2M - where M = 1\nP1 can choose btw min 1 or max 2, obviously max 2 so X = 2\nP2 - M = max(M,X) = max(1,2) = 2\nP2 now has 1 <= X <= 2(2) that is 4 piles to take\nBob will easily win\nP1 has to smartly choose M and not greedily choose the max\nBecause p2 will get the advantage otherwise\nPREFIX SUM - ADDING PAST NUMBERS","autoResize":false,"lineHeight":1.25},{"id":"UN6B_pl_dgKmarhAH6j19","type":"text","x":814.9921613754777,"y":-225.86021628380382,"width":171.7437286376953,"height":40,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b42","roundness":null,"seed":1142188018,"version":484,"versionNonce":615548398,"isDeleted":false,"boundElements":[],"updated":1788180783918,"link":null,"locked":false,"text":"- Alice Starts first\n- Both Play Optimally\n- Takes either first 1, first 2 or first 3 stones.\n- One with highest stone wines. Will Alice win?","fontSize":8,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"- Alice Starts first\n- Both Play Optimally\n- Takes either first 1, first 2 or first 3 stones.\n- One with highest stone wines. Will Alice win?","autoResize":true,"lineHeight":1.25},{"id":"SigLWzg4Rt2LMO44J_6X1","type":"rectangle","x":810.0551297671927,"y":-227.18199526012205,"width":181.94218378451367,"height":44.39003628829698,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b43","roundness":null,"seed":2095487410,"version":273,"version