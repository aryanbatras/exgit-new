8,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"- Alice divides array in 2 halves (can be any proposition of division)\n- Calulcates sum of both halves, one with more score is abandoned\n- Alice accumulates less scored half, and divides again with that half\n- Alice keeps dividing till 1 stone is left.\n- From all the PnC, max score is sought after and returned.\n- Note : If both halves have equal sum, alice has to make optimal choice.","autoResize":true,"lineHeight":1.25},{"id":"pUbs_9oAaNPNjtg_1Or7X","type":"text","x":411.4155866165762,"y":168.5445608996951,"width":57.199920654296875,"height":10,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b4X","roundness":null,"seed":1954526770,"version":39,"versionNonce":222688174,"isDeleted":false,"boundElements":[],"updated":1788180783919,"link":null,"locked":false,"text":"[6,2,3,4,5,5]","fontSize":8,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"[6,2,3,4,5,5]","autoResize":true,"lineHeight":1.25},{"id":"jdLsPmBFNTkmkO2fS-kkk","type":"freedraw","x":439.62084323046236,"y":164.72987065194155,"width":0.011919704294768962,"height":28.261618882744187,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b4Y","roundness":null,"seed":390995954,"version":15,"versionNonce":1541885422,"isDeleted":false,"boundElements":[],"updated":1788180783919,"link":null,"locked":false,"points":[[0,0],[0,0.12158098380609772],[0,0.7088250820585245],[0,13.446221091379584],[0,22.423347719197977],[0,26.96237111462142],[0,28.159904072762743],[0,28.261618882744187],[-0.011919704294768962,28.068519673170044],[-0.011919704294768962,28.068519673170044]],"pressures":[],"simulatePressure":true,"stro