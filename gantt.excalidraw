55874,"width":98.76785278320312,"height":10,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3p","roundness":null,"seed":1618934066,"version":110,"versionNonce":1704067246,"isDeleted":false,"boundElements":[],"updated":1788180783918,"link":null,"locked":false,"text":"Use 2D dp for memoization","fontSize":8,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Use 2D dp for memoization","autoResize":true,"lineHeight":1.25},{"id":"h-mkyyQfmlySO0iXPHTWE","type":"text","x":412.09961756355926,"y":-84.29842312094428,"width":169.81163024902344,"height":44.69340420436865,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3q","roundness":null,"seed":1751974642,"version":159,"versionNonce":1227471598,"isDeleted":false,"boundElements":[],"updated":1788180783918,"link":null,"locked":false,"text":"   public int solve(int[] piles, int i, int j, Integer[][] dp){\n        if(i > j) return 0;\n        if(i == j) return piles[i];\n        if(dp[i][j] != null) return dp[i][j];\n        // take i -> i+1, j -> 2 possibilites = i+2, j or i+1, j-1\n        int take_i = piles[i] + Math.min(solve(piles, i+2, j, dp), solve(piles, i+1, j-1, dp));\n        // take j -> i, j-1 -> 2 possibilites = i+1, j-1 or i, j-2\n        int take_j = piles[j] + Math.min(solve(piles, i+1, j-1, dp), solve(piles, i, j-2, dp));\n        return dp[i][j] = Math.max(take_i, take_j);\n    }\n","fontSize":3.2504293966813567,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"   public int solve(int[] piles, int i, int j, Integer[][] dp){\n        if(i > j) return 0;\n        if(i == j) return piles[i];\n        if(dp[i][j] != null) return dp[i][j];\n        // take i -> i+1, j -> 2 possibilites = i+2, j or i+1, j-1\n        int take_i = piles[i] + Math.min(solve(piles, i+2, j, dp), solve(piles, i+1, j-1, dp));\n        // take j -> i, j-1 -> 2 possibilites = i+1, j-1 or i, j-2\n        int take_j = piles[j] + Math.min(solve(piles, i+1, j-1, dp), solve(piles, i, j-2, dp));\n        return dp[i][j] = Math.max(take_i, take_j);\n    }\n","autoResize":true,"lineHeight":1.25},{"id":"vjjd01tgTznrWeJBgDM46","type":"text","x":414.1621048183373,"y":-127.08538974012123,"width":88.95931220667968,"height":28.503041853172427,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3r","roundness":null,"seed":1634981042,"version":153,"versionNonce":1313877294,"isDeleted":false,"boundElements":[],"updated":1788180783918,"link":null,"locked":false,"text":"        int i = 0, j = piles.length - 1;\n        int sum = find_sum(piles);\n        int n = piles.length;\n        Integer[][] dp = new Integer[n+1][n+1];\n        int p1 = solve(piles, i, j, dp);\n        int p2 = sum - p1;\n        return p1 >= p2;","fontSize":3.25749049750542,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"        int i = 0, j = piles.length - 1;\n        int sum = find_sum(piles);\n        int n = piles.length;\n        Integer[][] dp = new Integer[n+1][n+1];\n        int p1 = solve(piles, i, j, dp);\n        int p2 = sum - p1;\n        return p1 >= p2;","autoResize":false,"lineHeight":1.25},{"id":"JSATpMnZ1KDwhvxF6qyQr","type":"freedraw","x":454.4637120509451,"y":-130.15177716482896,"width":88.52875152768866,"height":38.934007179332525,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3s","roundness":null,"seed":1027239538,"version":145,"versionNonce":11145