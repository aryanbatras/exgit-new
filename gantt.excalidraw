s[i] - solve(stones, n, i + 1, dp), \n        Math.max(\n            (i + 1 < n) ? (stones[i] + stones[i + 1]) - solve(stones, n, i + 2, dp) : Integer.MIN_VALUE, \n            (i + 2 < n) ? (stones[i] + stones[i + 1] + stones[i + 2]) - solve(stones, n, i + 3, dp) : Integer.MIN_VALUE\n        )\n    );\n}\n","fontSize":4.509974582524472,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"public int solve(int[] stones, int n, int i, Integer[] dp) {\n    if (i >= n) return 0;\n    if (dp[i] != null) return dp[i];\n    return dp[i] = Math.max(\n        stones[i] - solve(stones, n, i + 1, dp), \n        Math.max(\n            (i + 1 < n) ? (stones[i] + stones[i + 1]) - solve(stones, n, i + 2, dp) : Integer.MIN_VALUE, \n            (i + 2 < n) ? (stones[i] + stones[i + 1] + stones[i + 2]) - solve(stones, n, i + 3, dp) : Integer.MIN_VALUE\n        )\n    );\n}\n","autoResize":true,"lineHeight":1.25},{"id":"kTswXbTs0S_WCzNGohS8O","type":"text","x":793.3810601340547,"y":-62.494902581027475,"width":52.79188537597656,"height":10,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b4D","roundness":null,"seed":337609522,"version":327,"versionNonce":898750126,"isDeleted":false,"boundElements":[],"updated":1788180783919,"link":null,"locked":false,"text":"Stone Game III","fontSize":8,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Stone Game III","autoResize":true,"lineHeight":1.25},{"id":"PLJdXkl8-mROZdOa-8tH5","type":"text","x":1129.7184109110894,"y":-226.83591073130265,"width":167.03970336914062,"height":40,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b4E","roundness":null,"seed":728517874,"version":457,"versionNonce":19