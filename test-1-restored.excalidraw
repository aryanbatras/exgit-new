{"type":"excalidraw","version":2,"source":"http://localhost:3000","elements":[{"id":"XRCQD_nlJOsL5wJMyd8Qi","type":"diamond","x":-336.3826164928032,"y":-1191.9062512014282,"width":303.64453125,"height":320.66796875,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a0","roundness":{"type":2},"seed":1007204306,"version":52,"versionNonce":1203841857,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false},{"id":"Tm3_MjJed-gjCUmksj3Se","type":"ellipse","x":-230.6794914928032,"y":-1074.1171887014282,"width":108.97656249999999,"height":92.18359375,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a1","roundness":{"type":2},"seed":227872910,"version":50,"versionNonce":1876695841,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false},{"id":"UVGqBTzRzlAiRFF1gGp48","type":"rectangle","x":-345.1833977428032,"y":-1206.9140637014282,"width":330.06640625,"height":352.80078125,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a2","roundness":{"type":3},"seed":1867821394,"version":77,"versionNonce":1523453697,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false},{"id":"tpl-45ci35et-nYm2TKM9zWwGw2c9_8yKE","type":"text","x":422.0454321130295,"y":-774.1132824514282,"width":117.158203125,"height":50,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a24","roundness":null,"seed":1538475905,"version":68,"versionNonce":521570017,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false,"text":"Load Balancer\n","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Load Balancer\n","autoResize":true,"lineHeight":1.25},{"id":"tpl-45ci35et-fhVmIZ_Lma0-ad_T0lTxP","type":"rectangle","x":400.3423071130295,"y":-479.2695324514282,"width":123.359375,"height":74.796875,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a28","roundness":{"type":3},"seed":1745569967,"version":59,"versionNonce":1464140481,"isDeleted":false,"boundElements":[{"id":"tpl-45ci35et-M1RXElSi7bABGVMcN3xaE","type":"arrow"},{"id":"tpl-45ci35et-4jhYQP-GMtNDRwirrUNKz","type":"arrow"},{"id":"tpl-45ci35et-FKPka70Jcp1Sj0kReAfRn","type":"arrow"},{"id":"tpl-45ci35et-Ntx5cYiOx7E87PG3y8of9","type":"arrow"},{"type":"text","id":"tpl-45ci35et-yM8QPZD0vdV1y3ggQaJEB"}],"updated":1787820528894,"link":null,"locked":false,"containerId":null},{"id":"tpl-45ci35et-yM8QPZD0vdV1y3ggQaJEB","type":"text","x":449.2436743005295,"y":-454.3710949514282,"width":25.556640625,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a2G","roundness":null,"seed":1579896495,"version":24,"versionNonce":536412833,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false,"text":"LB","fontSize":20,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"tpl-45ci35et-fhVmIZ_Lma0-ad_T0lTxP","originalText":"LB","autoResize":true,"lineHeight":1.25},{"id":"tpl-45ci35et-gzQNxutpkS_wO9TpXPNKk","type":"rectangle","x":678.0610571130296,"y":-582.8945324514282,"width":81.3671875,"height":56.17578125,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a2O","roundness":{"type":3},"seed":706669295,"version":45,"versionNonce":1440876161,"isDeleted":false,"boundElements":[{"id":"tpl-45ci35et-M1RXElSi7bABGVMcN3xaE","type":"arrow"},{"type":"text","id":"tpl-45ci35et-g7gBr1K25Wfl1uPBdOgI5"}],"updated":1787820528894,"link":null,"locked":false,"containerId":null},{"id":"tpl-45ci35et-g7gBr1K25Wfl1uPBdOgI5","type":"text","x":691.7915258630296,"y":-567.3066418264282,"width":53.90625,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a2V","roundness":null,"seed":233613743,"version":26,"versionNonce":331320929,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false,"text":"SVC 1","fontSize":20,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"tpl-45ci35et-gzQNxutpkS_wO9TpXPNKk","originalText":"SVC 1","autoResize":true,"lineHeight":1.25},{"id":"tpl-45ci35et-HDs1Krl6zrlcgKIMjZ-fI","type":"rectangle","x":679.3110571130296,"y":-492.3632824514282,"width":83.52734375,"height":61.625,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a3","roundness":{"type":3},"seed":1619646913,"version":86,"versionNonce":1885411905,"isDeleted":false,"boundElements":[{"id":"tpl-45ci35et-4jhYQP-GMtNDRwirrUNKz","type":"arrow"},{"type":"text","id":"tpl-45ci35et-jp4_KSmntUcFPA_1gSBDL"}],"updated":1787820528894,"link":null,"locked":false,"containerId":null},{"id":"tpl-45ci35et-jp4_KSmntUcFPA_1gSBDL","type":"text","x":694.1216039880296,"y":-474.0507824514282,"width":53.90625,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a3V","roundness":null,"seed":2068487073,"version":26,"versionNonce":2091264545,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false,"text":"SVC 2","fontSize":20,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"tpl-45ci35et-HDs1Krl6zrlcgKIMjZ-fI","originalText":"SVC 2","autoResize":true,"lineHeight":1.25},{"id":"tpl-45ci35et-sc1otMMkcFAtltDz5ewB7","type":"rectangle","x":679.2348852380296,"y":-392.4062512014282,"width":81.3671875,"height":56.17578125,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a4","roundness":{"type":3},"seed":872224737,"version":99,"versionNonce":25050625,"isDeleted":false,"boundElements":[{"id":"tpl-45ci35et-FKPka70Jcp1Sj0kReAfRn","type":"arrow"},{"type":"text","id":"tpl-45ci35et-vBFv3vOF93U0W5NbguQpR"}],"updated":1787820528894,"link":null,"locked":false,"containerId":null},{"id":"tpl-45ci35et-vBFv3vOF93U0W5NbguQpR","type":"text","x":692.9653539880296,"y":-376.8183605764282,"width":53.90625,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a4V","roundness":null,"seed":1120974351,"version":28,"versionNonce":2112411105,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false,"text":"SVC 3","fontSize":20,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"tpl-45ci35et-sc1otMMkcFAtltDz5ewB7","originalText":"SVC 3","autoResize":true,"lineHeight":1.25},{"id":"tpl-45ci35et-9YGkqGSAo5oJnMLezW3Gg","type":"rectangle","x":680.4848852380296,"y":-301.8750012014282,"width":83.52734375,"height":61.625,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a5","roundness":{"type":3},"seed":322008001,"version":141,"versionNonce":1693807041,"isDeleted":false,"boundElements":[{"id":"tpl-45ci35et-Ntx5cYiOx7E87PG3y8of9","type":"arrow"},{"type":"text","id":"tpl-45ci35et-1gzMa0aewjYK2yzs9Mhbu"}],"updated":1787820528894,"link":null,"locked":false,"containerId":null},{"id":"tpl-45ci35et-1gzMa0aewjYK2yzs9Mhbu","type":"text","x":695.2954321130296,"y":-283.5625012014282,"width":53.90625,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a5V","roundness":null,"seed":593597697,"version":26,"versionNonce":465801633,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false,"text":"SVC 4","fontSize":20,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"tpl-45ci35et-9YGkqGSAo5oJnMLezW3Gg","originalText":"SVC 4","autoResize":true,"lineHeight":1.25},{"id":"tpl-45ci35et-M1RXElSi7bABGVMcN3xaE","type":"arrow","x":523.3891821130296,"y":-465.4257824514282,"width":152.4765625,"height":94.9375,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a6","roundness":{"type":2},"seed":1933013039,"version":53,"versionNonce":931313025,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false,"points":[[0,0],[152.4765625,-94.9375]],"lastCommittedPoint":null,"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"arrow","elbowed":false,"containerId":null},{"id":"tpl-45ci35et-4jhYQP-GMtNDRwirrUNKz","type":"arrow","x":531.2016821130296,"y":-436.1445324514282,"width":151.67578125,"height":24.73046875,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a7","roundness":{"type":2},"seed":1540977871,"version":63,"versionNonce":2071092577,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false,"points":[[0,0],[151.67578125,-24.73046875]],"lastCommittedPoint":null,"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"arrow","elbowed":false,"containerId":null},{"id":"tpl-45ci35et-FKPka70Jcp1Sj0kReAfRn","type":"arrow","x":520.9360571130296,"y":-427.4257824514282,"width":160.3046875,"height":75.85546875,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a8","roundness":{"type":2},"seed":1859194895,"version":62,"versionNonce":383912257,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false,"points":[[0,0],[160.3046875,75.85546875]],"lastCommittedPoint":null,"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"arrow","elbowed":false,"containerId":null},{"id":"tpl-45ci35et-Ntx5cYiOx7E87PG3y8of9","type":"arrow","x":517.2954321130296,"y":-412.7695324514282,"width":158.9921875,"height":133.12109375,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a9","roundness":{"type":2},"seed":345150785,"version":59,"versionNonce":590428449,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false,"points":[[0,0],[158.9921875,133.12109375]],"lastCommittedPoint":null,"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"arrow","elbowed":false,"containerId":null},{"id":"tpl-45ci35et-algorithm-details-1","type":"text","x":828.5873295038673,"y":-636.821024690051,"width":850,"height":467.5,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffebee","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"aB","roundness":{"type":3},"seed":123456,"version":214,"versionNonce":1640983809,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false,"text":"LOAD BALANCING ALGORITHMS DETAILED\n\n1. ROUND ROBIN: \n- Sequential distribution to each server. \n- Fair but doesn't consider server load. \n- Best for uniform server capacity.\n\n2. STICKY/SESSION AFFINITY: \n- Route same client to same server (session state). \n- Use cookies or IP-based identification.\n\n3. WEIGHTED RR: \n- Assign weights based on capacity. \n- Server with weight 3 gets 3x more requests than weight 1.\n\n4. IP HASH: \n- Hash client IP to determine server. \n- Ensures same client hits same server. \n- Good for stateful apps.\n\n5. LEAST CONNECTIONS: \n- Route to server with fewest active connections. \n- Dynamic, adapts to real load. \n- Better for long-lived connections.\n\n6. LOWEST RESPONSE TIME: \n- Route to server with fastest response time (weighted by active connections). \n- Most intelligent but requires monitoring.\n\n7. LAYER 4 vs LAYER 7:\n   Layer 4 (TCP/UDP): Fast, simple, header-based routing.\n    - Use for non-HTTP protocols or ultra-low latency.\n   Layer 7 (HTTP/HTTPS): Content-aware, can route by URL path, hostname, headers. \n    - More powerful but slower.","fontSize":11,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"LOAD BALANCING ALGORITHMS DETAILED\n\n1. ROUND ROBIN: \n- Sequential distribution to each server. \n- Fair but doesn't consider server load. \n- Best for uniform server capacity.\n\n2. STICKY/SESSION AFFINITY: \n- Route same client to same server (session state). \n- Use cookies or IP-based identification.\n\n3. WEIGHTED RR: \n- Assign weights based on capacity. \n- Server with weight 3 gets 3x more requests than weight 1.\n\n4. IP HASH: \n- Hash client IP to determine server. \n- Ensures same client hits same server. \n- Good for stateful apps.\n\n5. LEAST CONNECTIONS: \n- Route to server with fewest active connections. \n- Dynamic, adapts to real load. \n- Better for long-lived connections.\n\n6. LOWEST RESPONSE TIME: \n- Route to server with fastest response time (weighted by active connections). \n- Most intelligent but requires monitoring.\n\n7. LAYER 4 vs LAYER 7:\n   Layer 4 (TCP/UDP): Fast, simple, header-based routing.\n    - Use for non-HTTP protocols or ultra-low latency.\n   Layer 7 (HTTP/HTTPS): Content-aware, can route by URL path, hostname, headers. \n    - More powerful but slower.","autoResize":false,"lineHeight":1.25},{"id":"tpl-45ci35et-lb-strategies","type":"text","x":44.88300850719679,"y":-596.3367545350875,"width":295.8437499999999,"height":275,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#f1f8f4","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"aD","roundness":{"type":3},"seed":123458,"version":305,"versionNonce":977020129,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false,"text":"LOAD BALANCER DEPLOYMENT STRATEGIES\n\n1. SINGLE LB: \n- Simple but creates single point of failure. \n- Not production-ready.\n\n2. HA PAIR (Active-Passive): \n- Two LBs with heartbeat. \n- Passive takes over if active fails. \n- Uses VIP (Virtual IP).\n\n3. ACTIVE-ACTIVE: \n- Multiple LBs handling traffic simultaneously. \n- DNS round-robin or Anycast. \n- Requires session replication or sticky sessions.\n\n4. GEOGRAPHIC LB: \n- Route users to nearest datacenter. \n- Lower latency, compliance. \n- Use GeoDNS.","fontSize":11,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"LOAD BALANCER DEPLOYMENT STRATEGIES\n\n1. SINGLE LB: \n- Simple but creates single point of failure. \n- Not production-ready.\n\n2. HA PAIR (Active-Passive): \n- Two LBs with heartbeat. \n- Passive takes over if active fails. \n- Uses VIP (Virtual IP).\n\n3. ACTIVE-ACTIVE: \n- Multiple LBs handling traffic simultaneously. \n- DNS round-robin or Anycast. \n- Requires session replication or sticky sessions.\n\n4. GEOGRAPHIC LB: \n- Route users to nearest datacenter. \n- Lower latency, compliance. \n- Use GeoDNS.","autoResize":false,"lineHeight":1.25},{"id":"tpl-45ci35et-health-checks","type":"text","x":58.3773330590667,"y":-304.2262362529523,"width":850,"height":233.75,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#fff3e0","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"aE","roundness":{"type":3},"seed":123459,"version":214,"versionNonce":2013716673,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false,"text":"HEALTH CHECKS (Critical for High Availability)\n\n1. TCP PROBE: Lightweight, fast. \n- Check if port is open. \n- Doesn't verify service health.\n\n2. HTTP/HTTPS: GET /health endpoint. \n- Can check dependencies (DB, cache). \n- Proper status codes (200=healthy, 503=sick).\n\n3. PASSIVE CHECKS: \n- Monitor error rates/response times. \n- Detect degradation in real-time.\n\n4. HEARTBEAT INTERVAL: 5-10 sec typical. \n- Lower = faster detection but more overhead. \n- Higher = less overhead but slower failover.","fontSize":11,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"HEALTH CHECKS (Critical for High Availability)\n\n1. TCP PROBE: Lightweight, fast. \n- Check if port is open. \n- Doesn't verify service health.\n\n2. HTTP/HTTPS: GET /health endpoint. \n- Can check dependencies (DB, cache). \n- Proper status codes (200=healthy, 503=sick).\n\n3. PASSIVE CHECKS: \n- Monitor error rates/response times. \n- Detect degradation in real-time.\n\n4. HEARTBEAT INTERVAL: 5-10 sec typical. \n- Lower = faster detection but more overhead. \n- Higher = less overhead but slower failover.","autoResize":false,"lineHeight":1.25},{"id":"tpl-45ci35et-session-persistence","type":"text","x":844.6772107099873,"y":-123.11411864375827,"width":850,"height":206.25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#f3e5f5","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"aF","roundness":{"type":3},"seed":123460,"version":242,"versionNonce":1221533857,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false,"text":"SESSION PERSISTENCE / STICKINESS\n\n1. COOKIE-BASED: \n- LB sets cookie with server ID. \n- Browser sends cookie on next request. Works across browsers but insecure (client can modify).\n\n2. IP-BASED (IP HASH): \n- Hash client IP to determine server. \n- Simple but issues with shared proxy IPs or mobile users.\n\n3. DISTRIBUTED SESSION STORE: \n- Store session in Redis/Memcached. \n- No affinity needed. \n- Stateless servers. \n- Recommended for microservices.","fontSize":11,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"SESSION PERSISTENCE / STICKINESS\n\n1. COOKIE-BASED: \n- LB sets cookie with server ID. \n- Browser sends cookie on next request. Works across browsers but insecure (client can modify).\n\n2. IP-BASED (IP HASH): \n- Hash client IP to determine server. \n- Simple but issues with shared proxy IPs or mobile users.\n\n3. DISTRIBUTED SESSION STORE: \n- Store session in Redis/Memcached. \n- No affinity needed. \n- Stateless servers. \n- Recommended for microservices.","autoResize":false,"lineHeight":1.25},{"id":"tpl-45ci35et-recommendations","type":"text","x":238.46006277887875,"y":8.901347044572276,"width":850,"height":206.25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffebee","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"aG","roundness":{"type":3},"seed":123461,"version":168,"versionNonce":2051302529,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false,"text":"RECOMMENDATIONS & BEST PRACTICES\n\n1. USE CDN FOR STATIC CONTENT: Cloudflare, Akamai reduce origin load.\n\n2. CONNECTION POOLING: LB maintains persistent connections to backends. Reduces latency.\n\n3. CIRCUIT BREAKER: Prevent cascading failures. Stop routing to unhealthy servers temporarily.\n\n4. RATE LIMITING: LB should limit per-client rates to prevent DDoS.\n\n5. MONITORING & LOGGING: Track request distribution, latency, error rates. Use metrics: p50, p95, p99 latency.\n\n6. GRACEFUL DEGRADATION: Shed load or reduce features if all servers overloaded.\n\n7. REAL-WORLD USE: AWS ELB, Google Cloud Load Balancer, Azure LB, HAProxy, NGINX Plus","fontSize":11,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"RECOMMENDATIONS & BEST PRACTICES\n\n1. USE CDN FOR STATIC CONTENT: Cloudflare, Akamai reduce origin load.\n\n2. CONNECTION POOLING: LB maintains persistent connections to backends. Reduces latency.\n\n3. CIRCUIT BREAKER: Prevent cascading failures. Stop routing to unhealthy servers temporarily.\n\n4. RATE LIMITING: LB should limit per-client rates to prevent DDoS.\n\n5. MONITORING & LOGGING: Track request distribution, latency, error rates. Use metrics: p50, p95, p99 latency.\n\n6. GRACEFUL DEGRADATION: Shed load or reduce features if all servers overloaded.\n\n7. REAL-WORLD USE: AWS ELB, Google Cloud Load Balancer, Azure LB, HAProxy, NGINX Plus","autoResize":false,"lineHeight":1.25},{"id":"tpl-45ci35et-comparison-content","type":"text","x":1463.024729406884,"y":-549.3784908041998,"width":469.54322909113523,"height":172.5002689225919,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"aI","roundness":null,"seed":123463,"version":371,"versionNonce":2015767649,"isDeleted":false,"boundElements":[],"updated":1787820528894,"link":null,"locked":false,"text":"ALGORITHM COMPARISON TABLE\n\nAlgorithm          | Complexity | Fairness | Awareness | State | Use Case\n─────────────────────────────────────\nRound Robin        | O(1)       | Perfect  | None      | No    | Uniform servers\n\nSticky RR          | O(1)       | Perfect  | None      | Yes   | Session state\n\nIP Hash            | O(1)       | Good     | Client IP | No    | Stateful apps\n\nLeast Connections  | O(log n)   | Good     | Real-time | Yes   | Long connections\n\nLowest Response    | O(log n)   | Excellent| Real-time | Yes   | Heterogeneous loads","fontSize":10.615401164467194,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"ALGORITHM COMPARISON TABLE\n\nAlgorithm          | Complexity | Fairness | Awareness | State | Use Case\n─────────────────────────────────────\nRound Robin        | O(1)       | Perfect  | None      | No    | Uniform servers\n\nSticky RR          | O(1)       | Perfect  | None      | Yes   | Session state\n\nIP Hash            | O(1)       | Good     | Client IP | No    | Stateful apps\n\nLeast Connections  | O(log n)   | Good     | Real-time | Yes   | Long connections\n\nLowest Response    | O(log n)   | Excellent| Real-time | Yes   | Heterogeneous loads","autoResize":false,"lineHeight":1.25}],"appState":{"gridSize":20,"gridStep":5,"gridModeEnabled":false,"viewBackgroundColor":"#ffffff"},"files":{}}